#!/bin/bash
#PBS -V
#PBS -N genotype_dp_filter
#PBS -l nodes=1:ppn=20,mem=64gb,walltime=100:00:00
#PBS -q batch
#PBS -o /usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/logs/genotype_dp_filter.log
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

echo "[$(date)] Starting genotype_dp_filter"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate genomics

PRJ=/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus
WORKDIR=$PRJ/reseq_WD/04_vcf

cd "$WORKDIR"

VAR_VCF=leuconotopicus.raw.variants.PASS.vcf.gz

echo "[$(date)] Counting PASS variant records before genotype filtering"
RAW_PASS_COUNT=$(bcftools view -H "$VAR_VCF" | wc -l)
echo "[$(date)] PASS variant count before genotype filtering: $RAW_PASS_COUNT"

echo "[$(date)] Applying genotype-level DP filter (DP < 3)"
gatk VariantFiltration \
  -V "$VAR_VCF" \
  -O leuconotopicus.raw.variants.PASS.DPfiltered.vcf.gz \
  --genotype-filter-expression "DP < 3" \
  --genotype-filter-name "DP_lt3"

echo "[$(date)] Indexing genotype-filtered VCF"
gatk IndexFeatureFile -I leuconotopicus.raw.variants.PASS.DPfiltered.vcf.gz

echo "[$(date)] Setting filtered genotypes to no-call"
gatk SelectVariants \
  -V leuconotopicus.raw.variants.PASS.DPfiltered.vcf.gz \
  --set-filtered-gt-to-nocall \
  -O leuconotopicus.raw.variants.PASS.DPfilterNoCall.vcf.gz

echo "[$(date)] Indexing no-call VCF"
gatk IndexFeatureFile -I leuconotopicus.raw.variants.PASS.DPfilterNoCall.vcf.gz

echo "[$(date)] Counting records after genotype no-call conversion"
FINAL_COUNT=$(bcftools view -H leuconotopicus.raw.variants.PASS.DPfilterNoCall.vcf.gz | wc -l)
echo "[$(date)] Variant count after genotype filtering/no-call: $FINAL_COUNT"

echo "[$(date)] Writing genotype filter summary table"
{
  echo -e "file\tcount"
  echo -e "pass_variants_before_genotype_filter\t$RAW_PASS_COUNT"
  echo -e "variants_after_genotype_filter_nocall\t$FINAL_COUNT"
} > leuconotopicus.raw.variants.genotype_filter_counts.tsv

echo "[$(date)] Finished genotype_dp_filter"

