#!/bin/bash
#PBS -V
#PBS -N split_snps_indels
#PBS -l nodes=1:ppn=20,mem=64gb,walltime=24:00:00
#PBS -q batch
#PBS -o /usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/logs/split_snps_indels.log
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate genomics

PRJ=/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus
WORKDIR=$PRJ/reseq_WD/04_vcf
LOGDIR=$PRJ/reseq_WD/logs

cd "$WORKDIR"

VCF=leuconotopicus.raw.variants.vcf.gz

[ -s "$VCF" ] || { echo "Input VCF not found: $VCF"; exit 1; }
[ -s "$VCF.tbi" ] || tabix -p vcf "$VCF"

echo "[$(date)] Starting SNP/INDEL split"

echo "[$(date)] Extracting SNPs"
gatk SelectVariants \
  -V "$VCF" \
  --select-type-to-include SNP \
  -O leuconotopicus.raw.snps.vcf.gz

echo "[$(date)] Indexing SNP VCF"
gatk IndexFeatureFile \
  -I leuconotopicus.raw.snps.vcf.gz

echo "[$(date)] Counting SNP records"
SNP_COUNT=$(bcftools view -H leuconotopicus.raw.snps.vcf.gz | wc -l)
echo "[$(date)] SNP count: $SNP_COUNT"

echo "[$(date)] Extracting INDELs"
gatk SelectVariants \
  -V "$VCF" \
  --select-type-to-include INDEL \
  -O leuconotopicus.raw.indels.vcf.gz

echo "[$(date)] Indexing INDEL VCF"
gatk IndexFeatureFile \
  -I leuconotopicus.raw.indels.vcf.gz

echo "[$(date)] Counting INDEL records"
INDEL_COUNT=$(bcftools view -H leuconotopicus.raw.indels.vcf.gz | wc -l)
echo "[$(date)] INDEL count: $INDEL_COUNT"

echo "[$(date)] Finished SNP/INDEL split"

