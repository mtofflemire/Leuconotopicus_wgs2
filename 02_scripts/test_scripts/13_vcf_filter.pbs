#!/bin/bash
#PBS -V
#PBS -N vcftools_filter_merge
#PBS -l nodes=1:ppn=20,mem=128gb,walltime=200:00:00
#PBS -q batch
#PBS -o /usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/logs/vcftools_filter_merge.log
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

echo "[$(date)] Starting vcftools_filter_merge"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate genomics

PRJ=/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus
WORKDIR=$PRJ/reseq_WD/04_vcf
THREADS=20

cd "$WORKDIR"

INV_VCF=leuconotopicus.raw.invariant.vcf.gz
VAR_VCF=leuconotopicus.raw.variants.PASS.DPfilterNoCall.vcf.gz

MAX_MISSING=0.8
MIN_MEAN_DP=4
MAX_MEAN_DP=20

echo "[$(date)] Counting raw invariant records"
RAW_INV_COUNT=$(bcftools view -H "$INV_VCF" | wc -l)
echo "[$(date)] Raw invariant count: $RAW_INV_COUNT"

echo "[$(date)] Filtering invariant sites with vcftools"
vcftools --gzvcf "$INV_VCF" \
  --remove-indels \
  --max-missing "$MAX_MISSING" \
  --min-meanDP "$MIN_MEAN_DP" \
  --max-meanDP "$MAX_MEAN_DP" \
  --recode --stdout | bgzip -@ "$THREADS" -c > leuconotopicus.invariant.filtered.vcf.gz

tabix -p vcf leuconotopicus.invariant.filtered.vcf.gz

INV_FILTERED_COUNT=$(bcftools view -H leuconotopicus.invariant.filtered.vcf.gz | wc -l)
INV_REMOVED_COUNT=$((RAW_INV_COUNT - INV_FILTERED_COUNT))
echo "[$(date)] Filtered invariant count: $INV_FILTERED_COUNT"
echo "[$(date)] Removed invariant count: $INV_REMOVED_COUNT"

echo "[$(date)] Counting PASS DP-masked variant records before vcftools filtering"
RAW_VAR_COUNT=$(bcftools view -H "$VAR_VCF" | wc -l)
echo "[$(date)] Raw variant count before vcftools: $RAW_VAR_COUNT"

echo "[$(date)] Filtering variant sites with vcftools depth/missingness only"
vcftools --gzvcf "$VAR_VCF" \
  --remove-indels \
  --max-missing "$MAX_MISSING" \
  --min-meanDP "$MIN_MEAN_DP" \
  --max-meanDP "$MAX_MEAN_DP" \
  --max-alleles 2 \
  --recode --stdout | bgzip -@ "$THREADS" -c > leuconotopicus.variants.filtered.vcf.gz

tabix -p vcf leuconotopicus.variants.filtered.vcf.gz

VAR_FILTERED_COUNT=$(bcftools view -H leuconotopicus.variants.filtered.vcf.gz | wc -l)
VAR_REMOVED_COUNT=$((RAW_VAR_COUNT - VAR_FILTERED_COUNT))
echo "[$(date)] Filtered variant count: $VAR_FILTERED_COUNT"
echo "[$(date)] Removed variant count: $VAR_REMOVED_COUNT"

echo "[$(date)] Merging filtered variants + filtered invariants"
bcftools concat --threads "$THREADS" \
  --allow-overlaps \
  leuconotopicus.variants.filtered.vcf.gz \
  leuconotopicus.invariant.filtered.vcf.gz \
  -O z -o leuconotopicus.allsites.final.vcf.gz

tabix -p vcf leuconotopicus.allsites.final.vcf.gz

ALLSITES_COUNT=$(bcftools view -H leuconotopicus.allsites.final.vcf.gz | wc -l)
echo "[$(date)] Final merged all-sites count: $ALLSITES_COUNT"

echo "[$(date)] Writing filter summary table"
{
  echo -e "file\tcount"
  echo -e "raw_invariant\t$RAW_INV_COUNT"
  echo -e "filtered_invariant\t$INV_FILTERED_COUNT"
  echo -e "removed_invariant\t$INV_REMOVED_COUNT"
  echo -e "raw_variants_before_vcftools\t$RAW_VAR_COUNT"
  echo -e "filtered_variants\t$VAR_FILTERED_COUNT"
  echo -e "removed_variants\t$VAR_REMOVED_COUNT"
  echo -e "final_allsites_filtered\t$ALLSITES_COUNT"
} > leuconotopicus.vcftools_filter_counts.tsv

echo "[$(date)] Finished vcftools_filter_merge"
