#!/bin/bash
#PBS -V
#PBS -N hardfilter_variants
#PBS -l nodes=1:ppn=20,mem=64gb,walltime=100:00:00
#PBS -q batch
#PBS -o /usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/logs/hardfilter_variants.log
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

echo "[$(date)] Starting hardfilter_variants"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate genomics

PRJ=/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus
WORKDIR=$PRJ/reseq_WD/04_vcf
THREADS=20

cd "$WORKDIR"

VAR_VCF=leuconotopicus.raw.variants.vcf.gz

echo "[$(date)] Counting raw variant records"
RAW_COUNT=$(bcftools view -H "$VAR_VCF" | wc -l)
echo "[$(date)] Raw variant count: $RAW_COUNT"

echo "[$(date)] Hard-filtering variant sites with empirical 1% tail thresholds"
gatk VariantFiltration \
  -V "$VAR_VCF" \
  -O leuconotopicus.raw.variants.hardfiltered.vcf.gz \
  --filter-name QUAL40 \
  --filter-expression "QUAL < 40.0" \
  --filter-name DP10_512 \
  --filter-expression "DP < 10 || DP > 512" \
  --filter-name QD3_25 \
  --filter-expression "QD < 3.25" \
  --filter-name FS18_75 \
  --filter-expression "FS > 18.75" \
  --filter-name SOR4_47 \
  --filter-expression "SOR > 4.47"

echo "[$(date)] Indexing hard-filtered VCF"
gatk IndexFeatureFile -I leuconotopicus.raw.variants.hardfiltered.vcf.gz

echo "[$(date)] Counting PASS and filtered records"
PASS_COUNT=$(bcftools view -f PASS -H leuconotopicus.raw.variants.hardfiltered.vcf.gz | wc -l)
FILTERED_COUNT=$((RAW_COUNT - PASS_COUNT))
echo "[$(date)] PASS variant count: $PASS_COUNT"
echo "[$(date)] Filtered variant count: $FILTERED_COUNT"

echo "[$(date)] Keeping PASS sites only"
bcftools view --threads "$THREADS" -f PASS -Oz \
  -o leuconotopicus.raw.variants.PASS.vcf.gz \
  leuconotopicus.raw.variants.hardfiltered.vcf.gz

tabix -p vcf leuconotopicus.raw.variants.PASS.vcf.gz

echo "[$(date)] Writing filter summary table"
{
  echo -e "file\tcount"
  echo -e "raw_variants\t$RAW_COUNT"
  echo -e "pass_variants\t$PASS_COUNT"
  echo -e "filtered_variants\t$FILTERED_COUNT"
} > leuconotopicus.raw.variants.filter_counts.tsv

echo "[$(date)] Finished hardfilter_variants"

