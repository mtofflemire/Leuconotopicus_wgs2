#!/bin/bash
#PBS -V
#PBS -N prep_shards
#PBS -l nodes=1:ppn=4,mem=32gb,walltime=500:00:00
#PBS -q batch
#PBS -o /usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/logs/prep_shards.log
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate genomics

REF=/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/ref_genome/GCF_014839835.1_bDryPub1.pri_genomic.fna
OUTDIR=/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/02_vcf/shards
SPLITS=48

mkdir -p "$OUTDIR"
rm -f "$OUTDIR"/* 2>/dev/null || true

[ -f "${REF}.fai" ] || samtools faidx "$REF"
DICT="${REF%.*}.dict"
[ -f "$DICT" ] || gatk CreateSequenceDictionary -R "$REF" -O "$DICT"

gatk SplitIntervals -R "$REF" --scatter-count "$SPLITS" -O "$OUTDIR"

find "$OUTDIR" -type f -name '*.interval_list' | sort -V > "$OUTDIR/intervals.list"
wc -l "$OUTDIR/intervals.list" || true
echo "Shards ready in $OUTDIR"
