#!/bin/bash
#PBS -V
#PBS -N run_pixy
#PBS -l nodes=1:ppn=20,mem=128gb,walltime=500:00:00
#PBS -q batch
#PBS -o /usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/logs/run_pixy.log
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate pixy
export PATH=/home/mtofflemire/.conda/envs/genomics/bin:$PATH

PRJ=/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus
VCF_DIR=$PRJ/reseq_WD/04_vcf
POP_DIR=$PRJ/scripts/HaplotypeCaller
OUT_DIR=$PRJ/reseq_WD/05_pixy_results

VCF=$VCF_DIR/leuconotopicus.allsites.filteredQC.vcf.gz
POPS=$POP_DIR/pop.names.txt
WINDOW=10000
THREADS=20

mkdir -p "$OUT_DIR"

[ -s "$VCF" ] || { echo "Missing $VCF"; exit 1; }
[ -s "$VCF.tbi" ] || { echo "Missing $VCF.tbi"; exit 1; }
[ -s "$POPS" ] || { echo "Missing $POPS"; exit 1; }

pixy \
  --stats pi dxy fst \
  --vcf "$VCF" \
  --populations "$POPS" \
  --window_size "$WINDOW" \
  --n_cores "$THREADS" \
  --output_folder "$OUT_DIR" \
  --output_prefix leuconotopicus

