#!/bin/bash
#PBS -V
#PBS -N split_snps_indels
#PBS -l nodes=1:ppn=20,mem=64gb,walltime=500:00:00
#PBS -q batch
#PBS -o /usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/logs/split_snps_indels.log
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate genomics

PRJ=/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus
IN_DIR=$PRJ/reseq_WD/04_vcf
OUT_DIR=$PRJ/reseq_WD/04_vcf

VCF=$IN_DIR/leuconotopicus.allsites.merged.sorted.vcf.gz

SNP_VCF=$OUT_DIR/leuconotopicus.raw.snps.vcf.gz
INDEL_VCF=$OUT_DIR/leuconotopicus.raw.indels.vcf.gz

[ -s "$VCF" ] || { echo "Input VCF not found: $VCF"; exit 1; }
[ -s "$VCF.tbi" ] || gatk IndexFeatureFile -I "$VCF"

echo "Selecting SNPs..."
gatk SelectVariants \
  -V "$VCF" \
  --select-type-to-include SNP \
  -O "$SNP_VCF"

gatk IndexFeatureFile -I "$SNP_VCF"

echo "Selecting INDELs..."
gatk SelectVariants \
  -V "$VCF" \
  --select-type-to-include INDEL \
  -O "$INDEL_VCF"

gatk IndexFeatureFile -I "$INDEL_VCF"

echo "Done."
echo "SNP VCF: $SNP_VCF"
echo "INDEL VCF: $INDEL_VCF"
