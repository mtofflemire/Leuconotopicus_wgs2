#!/bin/bash
#PBS -V
#PBS -N hc_gvcf_array
# Use 4 threads per task (array slot)
# Adjust mem/walltime to your cluster norms
#PBS -l nodes=1:ppn=4,mem=16gb,walltime=500:00:00
#PBS -q batch
# One log per array task:
#PBS -o /usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/02_vcf/hc_gvcf_array.$PBS_ARRAYID.log
#PBS -j oe
# No #PBS -t line here; pass -t from qsub.

set -euo pipefail
shopt -s nullglob

# Activate env
cd "$PBS_O_WORKDIR"
source ~/miniconda3/etc/profile.d/conda.sh
conda activate genomics

# ---- Paths ----
REF="/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/ref_genome/GCF_014839835.1_bDryPub1.pri_genomic.fna"
BAM_DIR="/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/01_bam_files"
OUT_ROOT="/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/02_vcf"
LOG_DIR="$OUT_ROOT/logs"

mkdir -p "$OUT_ROOT" "$LOG_DIR"

# ---- Select the BAM for this array index ----
BAMS=("$BAM_DIR"/*.dedup.bam)

[ "${#BAMS[@]}" -gt 0 ] || {
  echo "No .dedup.bam files found in $BAM_DIR"
  exit 1
}

IDX=$((PBS_ARRAYID - 1))

[ "$IDX" -ge 0 ] && [ "$IDX" -lt "${#BAMS[@]}" ] || {
  echo "PBS_ARRAYID=$PBS_ARRAYID is out of range. Found ${#BAMS[@]} BAMs."
  exit 1
}

BAM="${BAMS[$IDX]}"
SAMPLE="$(basename "$BAM" .dedup.bam)"

# ---- Reliable script-owned log ----
TASK_LOG="$LOG_DIR/hc_gvcf_array.${PBS_ARRAYID}.${SAMPLE}.log"
exec > "$TASK_LOG" 2>&1

# ---- Threads: use the cores requested via ppn ----
THREADS="${PBS_NUM_PPN:-4}"

echo "Running HaplotypeCaller for $SAMPLE"
echo "PBS job ID: ${PBS_JOBID:-NA}"
echo "PBS array ID: ${PBS_ARRAYID:-NA}"
echo "Array index: $IDX"
echo "Host: $(hostname)"
echo "Reference: $REF"
echo "Input BAM: $BAM"
echo "Output GVCF: $OUT_ROOT/${SAMPLE}.g.vcf.gz"
echo "Task log: $TASK_LOG"
echo "Threads: $THREADS"
echo "Started at $(date)"

gatk --java-options "-Xmx12g" HaplotypeCaller \
  -R "$REF" \
  -I "$BAM" \
  -O "$OUT_ROOT/${SAMPLE}.g.vcf.gz" \
  -ERC GVCF \
  --native-pair-hmm-threads "$THREADS" \
  --annotation QualByDepth \
  --annotation FisherStrand \
  --annotation StrandOddsRatio \
  --annotation RMSMappingQuality \
  --annotation MappingQualityRankSumTest \
  --annotation ReadPosRankSumTest

gatk IndexFeatureFile -I "$OUT_ROOT/${SAMPLE}.g.vcf.gz"

echo "Finished HaplotypeCaller for $SAMPLE at $(date)"

