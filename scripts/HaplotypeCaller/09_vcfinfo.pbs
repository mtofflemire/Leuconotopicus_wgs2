#!/bin/bash
#PBS -V
#PBS -N raw_site_qc
#PBS -l nodes=1:ppn=20,mem=128gb,walltime=100:00:00
#PBS -q batch
#PBS -o /usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus/reseq_WD/logs/raw_site_qc.log
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate genomics

PRJ=/usr/scratch2/userdata2/mtofflemire/projects/leuconotopicus
WORKDIR=$PRJ/reseq_WD/02_Variants/MERGED_VCFs
cd "$WORKDIR"

INV_VCF=leuconotopicus.raw.invariant.vcf.gz
SNP_VCF=leuconotopicus.raw.snps.vcf.gz
INDEL_VCF=leuconotopicus.raw.indels.vcf.gz

[ -s "$INV_VCF" ] || { echo "Missing $INV_VCF"; exit 1; }
[ -s "$SNP_VCF" ] || { echo "Missing $SNP_VCF"; exit 1; }
[ -s "$INDEL_VCF" ] || { echo "Missing $INDEL_VCF"; exit 1; }

[ -s "$INV_VCF.tbi" ] || tabix -p vcf "$INV_VCF"
[ -s "$SNP_VCF.tbi" ] || tabix -p vcf "$SNP_VCF"
[ -s "$INDEL_VCF.tbi" ] || tabix -p vcf "$INDEL_VCF"

run_common_qc () {
  local vcf=$1
  local prefix=$2

  echo "[$(date)] Running common QC for $vcf"

  bcftools stats "$vcf" > "${prefix}.bcftools.stats.txt"
  bcftools query -l "$vcf" > "${prefix}.samples.txt"

  vcftools --gzvcf "$vcf" --missing-indv --out "$prefix"
  vcftools --gzvcf "$vcf" --missing-site --out "$prefix"
  vcftools --gzvcf "$vcf" --site-mean-depth --out "$prefix"
  vcftools --gzvcf "$vcf" --depth --out "$prefix"
}

run_variant_qc () {
  local vcf=$1
  local prefix=$2

  echo "[$(date)] Running variant-only QC for $vcf"

  vcftools --gzvcf "$vcf" --freq2 --max-alleles 2 --out "$prefix"
  vcftools --gzvcf "$vcf" --site-quality --out "$prefix"
  vcftools --gzvcf "$vcf" --het --out "$prefix"

  gatk VariantsToTable \
    -V "$vcf" \
    -F CHROM \
    -F POS \
    -F TYPE \
    -F QUAL \
    -F DP \
    -F QD \
    -F FS \
    -F SOR \
    -F MQ \
    -F MQRankSum \
    -F ReadPosRankSum \
    -O "${prefix}.annotations.table"

  bcftools query -f '%CHROM\t%POS\t%QUAL\t%INFO/DP\t%INFO/QD\t%INFO/FS\t%INFO/SOR\t%INFO/MQ\t%INFO/MQRankSum\t%INFO/ReadPosRankSum\n' \
    "$vcf" | awk '
    BEGIN {
      total=0; qual=0; dp=0; qd=0; fs=0; sor=0; mq=0; mqrank=0; rprank=0
    }
    {
      total++
      if($3=="." || $3=="") qual++
      if($4=="." || $4=="") dp++
      if($5=="." || $5=="") qd++
      if($6=="." || $6=="") fs++
      if($7=="." || $7=="") sor++
      if($8=="." || $8=="") mq++
      if($9=="." || $9=="") mqrank++
      if($10=="." || $10=="") rprank++
    }
    END {
      print "metric\tmissing_count\tpercent_missing"
      print "QUAL\t" qual "\t" (qual/total)*100
      print "DP\t" dp "\t" (dp/total)*100
      print "QD\t" qd "\t" (qd/total)*100
      print "FS\t" fs "\t" (fs/total)*100
      print "SOR\t" sor "\t" (sor/total)*100
      print "MQ\t" mq "\t" (mq/total)*100
      print "MQRankSum\t" mqrank "\t" (mqrank/total)*100
      print "ReadPosRankSum\t" rprank "\t" (rprank/total)*100
    }' > "${prefix}.annotation_missingness.txt"
}

echo "[$(date)] Starting invariant QC"
run_common_qc "$INV_VCF" "leuconotopicus.raw.invariant"

echo "[$(date)] Starting SNP QC"
run_common_qc "$SNP_VCF" "leuconotopicus.raw.snps"
run_variant_qc "$SNP_VCF" "leuconotopicus.raw.snps"

echo "[$(date)] Starting INDEL QC"
run_common_qc "$INDEL_VCF" "leuconotopicus.raw.indels"
run_variant_qc "$INDEL_VCF" "leuconotopicus.raw.indels"

echo "[$(date)] Finished raw_site_qc"

